# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop / Claude Code / Zed)
# "streamable-http" — remote HTTP server (containers, cloud deploys)
#
# On a cloud host (IBM Code Engine, Databricks Apps) you usually leave this as
# stdio: app.py automatically switches to HTTP when the platform injects a port
# (DATABRICKS_APP_PORT or PORT).
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when running over HTTP) ───────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── Dataset API Keys ─────────────────────────────────────────────────────────
# Add a variable for each federal API your tools call, and a matching typed
# field in src/example_server/config.py. Never commit the filled-in .env.
#
# EXAMPLE_API_KEY=your_key_here

# ─── ServiceNow (gsa_jdp_post_servicenow_record tool) ────────────────────────
# OAuth password-grant credentials for the weather-alert tag updater.
# The tool POSTs to label_entry to apply a Weather Alert tag on cmn_location.
# Copy these lines to .env (gitignored) and fill in your real values.
#
# SERVICENOW_INSTANCE=dev12345.service-now.com
# SERVICENOW_CLIENT_ID=your_oauth_client_id
# SERVICENOW_CLIENT_SECRET=your_oauth_client_secret
# SERVICENOW_USER=your_username
# SERVICENOW_PASSWORD=your_password
